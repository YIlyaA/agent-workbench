{
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv run python scripts/check.py *)",
      "Bash(uv run python scripts/validate_agent_layer.py *)",
      "Bash(uv run python scripts/git_metrics.py *)",
      "Bash(uv run python scripts/metrics_report.py *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run mypy *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git worktree list *)"
    ],
    "ask": [
      "Edit(./.claude/settings.json)",
      "Edit(./.claude/hooks/**)",
      "Edit(./hooks/**)",
      "Edit(./scripts/log_event.py)",
      "Edit(./.github/workflows/**)",
      "Edit(~/.claude/**)",
      "Bash(uv run python scripts/install.py --apply*)",
      "Bash(gh pr merge *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git push origin main *)",
      "Bash(git push origin master *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "uv", "args": ["run", "--no-project", "python", "${CLAUDE_PROJECT_DIR}/scripts/log_event.py"] }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "uv", "args": ["run", "--no-project", "python", "${CLAUDE_PROJECT_DIR}/scripts/log_event.py"] }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "uv", "args": ["run", "--no-project", "python", "${CLAUDE_PROJECT_DIR}/scripts/log_event.py"] }] }
    ],
    "PostToolUseFailure": [
      { "hooks": [{ "type": "command", "command": "uv", "args": ["run", "--no-project", "python", "${CLAUDE_PROJECT_DIR}/scripts/log_event.py"] }] }
    ]
  }
}
